<?php
$postMessage = trim($_POST['message'] ?? '');
$postFeedback = '';

if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
    $postFeedback = $postMessage === ''
        ? 'Please enter a message.'
        : 'Message received successfully.';
}
?>

<form method="post" action="index.php" class="search-form post-form">
    <label for="message">Send a message</label>
    <textarea id="message" name="message" rows="4" placeholder="Enter your message"><?= htmlspecialchars($postMessage, ENT_QUOTES, 'UTF-8') ?></textarea>
    <button type="submit">Send message</button>
</form>

<?php if ($postFeedback !== ''): ?>
    <p class="post-feedback" role="status">
        <?= htmlspecialchars($postFeedback, ENT_QUOTES, 'UTF-8') ?>
    </p>
<?php endif; ?>
